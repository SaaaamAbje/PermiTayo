# Permitayo environment variables.
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Public (sent to the browser) ---------------------------------------
# Supabase dashboard: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase dashboard: Project Settings > API Keys. Use the "anon" (legacy) key or
# the "publishable" key (sb_publishable_...). Safe to expose; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public address of this app. Used in confirmation and password reset email links.
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ------------------------
# Phase 5 automated document checks (OCR + AI). Google AI Studio > Get API key.
# Set it on the hosting platform as a server-side variable (Vercel: NOT "NEXT_PUBLIC").
# Without it, checks still read digital PDFs and run rule checks, but results are inconclusive.
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# Supabase dashboard: Project Settings > API Keys > "service_role" / secret key.
# Used ONLY by scripts/create-admin.mjs to provision the first administrator.
# The web app itself never reads this value. Leave empty on hosting platforms.
SUPABASE_SERVICE_ROLE_KEY=
